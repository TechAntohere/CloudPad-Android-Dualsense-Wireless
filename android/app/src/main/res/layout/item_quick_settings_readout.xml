<?xml version="1.0" encoding="utf-8"?>
<!-- Read-only label/value row for QuickSettingsPanel. Mirrors the padding and
     label styling of item_quick_settings_switch so readouts sit flush with the
     interactive rows around them. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/quickSettingsReadoutLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:textColor="?attr/pyluxAccent"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/quickSettingsReadoutValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textSize="13sp" />

</LinearLayout>
